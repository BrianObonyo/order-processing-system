HTTP_ADDR=:8080
DATABASE_URL=postgres://orders:orders@localhost:5432/orders?sslmode=disable
REDIS_ADDR=localhost:6379
KAFKA_BROKERS=localhost:29092
KAFKA_TOPIC=order-events
KAFKA_GROUP_ID=order-processing

# key:user pairs. Replace before any real deployment.
API_KEYS=dev-key-1:user-1,dev-key-2:user-2

# Set false to run the API without the outbox relay, payment consumer and recovery worker.
RUN_WORKERS=true

# Simulated payment gateway
PAYMENT_FAILURE_RATE=0.1
PAYMENT_TRANSIENT_RATE=0.1
PAYMENT_LATENCY=100ms

# Recovery
RECOVERY_INTERVAL=15s
PAYMENT_RETRY_AFTER=30s
PAYMENT_MAX_RECOVERY=3
ORDER_PAYMENT_TIMEOUT=2m
OUTBOX_POLL_INTERVAL=300ms
